{
  "name": "zuber-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "static:check": "eslint . --ext .js,.jsx,.ts,.tsx && prettier --check --ignore-unknown .",
    "static:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx && prettier --log-level silent --write --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "test:api": "node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "test:ui": "node --import tsx --test app/wedding/v2/invitation/*.test.js",
    "test": "npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@emailjs/browser": "^5.0.2",
    "aws-jwt-verify": "^5.2.1",
    "axios": "^1.20.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "framer-motion": "^14.0.0",
    "next": "16.4.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-spinners": "^0.17.1",
    "read-excel-file": "^9.3.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
